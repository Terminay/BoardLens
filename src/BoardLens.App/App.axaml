<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BoardLens.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E"/>
          <SolidColorBrush x:Key="AppForeground" Color="#D4D4D4"/>
          <SolidColorBrush x:Key="ToolbarBackground" Color="#252528"/>
          <SolidColorBrush x:Key="ToolbarBorder" Color="#343438"/>
          <SolidColorBrush x:Key="SidebarBackground" Color="#212124"/>
          <SolidColorBrush x:Key="SidebarBorder" Color="#2D2D32"/>
          <SolidColorBrush x:Key="ContentBackground" Color="#1A1A1C"/>
          <SolidColorBrush x:Key="SurfaceBackground" Color="#242427"/>
          <SolidColorBrush x:Key="SurfaceBorder" Color="#343438"/>
          <SolidColorBrush x:Key="SectionHeaderBackground" Color="#2A2A2E"/>
          <SolidColorBrush x:Key="StrongForeground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MutedForeground" Color="#AAAAAA"/>
          <SolidColorBrush x:Key="SecondaryForeground" Color="#9E9EA4"/>
          <SolidColorBrush x:Key="ButtonBackground" Color="#2D2D30"/>
          <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ButtonHoverBackground" Color="#3E3E42"/>
          <SolidColorBrush x:Key="ChartBackground" Color="#1C1C1E"/>
          <SolidColorBrush x:Key="ChartBorder" Color="#2C2C30"/>
          <SolidColorBrush x:Key="ChartGrid" Color="#28282C"/>
          <SolidColorBrush x:Key="IconForeground" Color="#E0E0E0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground" Color="#F3F4F6"/>
          <SolidColorBrush x:Key="AppForeground" Color="#202124"/>
          <SolidColorBrush x:Key="ToolbarBackground" Color="#E8EAED"/>
          <SolidColorBrush x:Key="ToolbarBorder" Color="#DADCE0"/>
          <SolidColorBrush x:Key="SidebarBackground" Color="#F1F3F4"/>
          <SolidColorBrush x:Key="SidebarBorder" Color="#DADCE0"/>
          <SolidColorBrush x:Key="ContentBackground" Color="#F7F8FA"/>
          <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SurfaceBorder" Color="#DADCE0"/>
          <SolidColorBrush x:Key="SectionHeaderBackground" Color="#F1F3F4"/>
          <SolidColorBrush x:Key="StrongForeground" Color="#202124"/>
          <SolidColorBrush x:Key="MutedForeground" Color="#5F6368"/>
          <SolidColorBrush x:Key="SecondaryForeground" Color="#60656D"/>
          <SolidColorBrush x:Key="ButtonBackground" Color="#E8EAED"/>
          <SolidColorBrush x:Key="ButtonForeground" Color="#202124"/>
          <SolidColorBrush x:Key="ButtonHoverBackground" Color="#DADCE0"/>
          <SolidColorBrush x:Key="ChartBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="ChartBorder" Color="#DADCE0"/>
          <SolidColorBrush x:Key="ChartGrid" Color="#E8EAED"/>
          <SolidColorBrush x:Key="IconForeground" Color="#5F6368"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
      <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
    </Style>
    <Style Selector="Button.icon-btn">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="4,2"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </Application.Styles>
</Application>
